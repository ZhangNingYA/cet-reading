NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cet_reading:cet_reading@localhost:15432/cet_reading
# Production defaults to the local Compose database. External mode uses DATABASE_URL
# with an encoded password and sslmode=verify-full; see docs/EXTERNAL_DATABASE.md.
CET_DATABASE_MODE=local
CORS_ORIGIN=http://localhost:4321,http://localhost:8081
PROMPT_VERSION=cet-reading-v2
AI_MODEL=
AI_API_URL=https://api.fulafu.com/v1
AI_API_KEY=
AI_DRY_RUN=true
AI_REQUEST_TIMEOUT_MS=180000
JOB_LEASE_SECONDS=210
WORKER_CONCURRENCY=4
ANALYSIS_MAX_ATTEMPTS=3
BACKFILL_ENABLED=true
BACKFILL_INTERVAL_MS=20000
BACKFILL_TARGET=8
ADMIN_ENABLED=false
APPROVAL_WECHAT_APP_ID=
APPROVAL_WECHAT_APP_SECRET=
# Required before enabling approval login in production. Use a random value of at least 32 characters.
APPROVAL_SESSION_SECRET=
APPROVAL_SESSION_TTL_SECONDS=2592000
# Local-only test authentication. Keep false on a shared or production server.
APPROVAL_DEV_AUTH=false
NEWS_ENABLED=false
# Leave blank to use AI_MODEL for news selection. Sentence analysis keeps AI_MODEL.
NEWS_MODEL=
NEWS_MAX_ROUNDS=10

---
import type { ReadingSection } from '../data/sections';

type Props = { section: ReadingSection };
const { section } = Astro.props;
const { label, examLevels } = section;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<section class="library-section container" id="library" data-api-base={apiBase} data-exam-levels={JSON.stringify(examLevels)} aria-labelledby="library-title">
  <div class="library-heading">
    <div class="section-heading"><div class="library-title-line"><h1 id="library-title">{label}</h1><span class="paper-count" id="paper-count"></span></div></div>
    <div class="library-toolbar">
      <label class="paper-search">
        <span class="sr-only">搜索试卷标题或年份</span><input id="paper-search" type="search" placeholder="搜索试卷或年份" autocomplete="off" />
      </label>
    </div>
  </div>
  <div class="library-content"><div class="library-results" aria-busy="true" id="library-results">
    <div class="library-status"><p class="sr-only" id="status" role="status" aria-live="polite">正在加载</p><button type="button" class="text-link" id="retry-papers" hidden>重试</button></div>
    <div class="paper-grid" id="papers"><div class="paper-skeleton" aria-hidden="true"><span></span><span></span><span></span></div></div>
    <noscript><p class="empty-state">请启用 JavaScript，以加载试卷列表。</p></noscript>
  </div></div>
</section>

<section class="reader-section container" id="reader" hidden aria-labelledby="reader-title">
  <div class="reader-topline">
    <button type="button" class="text-link" id="close-reader"><span aria-hidden="true">←</span> 返回题库</button>
    <div class="mode-switch" role="group" aria-label="学习模式"><button type="button" data-reader-mode="intensive">精读</button><button type="button" data-reader-mode="practice">做题</button></div>
  </div>
  <div class="reader-panel"><header class="reader-heading"><p class="reader-meta sr-only" id="reader-meta"></p><h1 id="reader-title" tabindex="-1">准备开始</h1><p id="reader-status" role="status" aria-live="polite"></p></header><div id="reader-content"></div></div>
</section>

<script>
  import '../scripts/paper-library.js';
</script>

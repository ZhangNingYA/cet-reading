---
import type { ReadingSection } from '../data/sections';

type Props = { section: ReadingSection };
const { section } = Astro.props;
const { label, examLevels } = section;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<section class="library-section container" id="library" aria-labelledby="library-title">
  <div class="section-heading"><h2 id="library-title">{label}</h2></div>
  <div class="library-toolbar">
    <label class="paper-search">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      <span class="sr-only">搜索文章标题或年份</span><input id="paper-search" type="search" placeholder="搜索标题或年份" autocomplete="off" />
    </label>
  </div>
  <div class="library-content"><div class="library-results" aria-busy="true" id="library-results">
    <div class="library-status"><p class="sr-only" id="status" role="status" aria-live="polite">正在加载</p><button type="button" class="text-link" id="retry-papers" hidden>重试</button></div>
    <div class="paper-grid" id="papers"><div class="paper-skeleton" aria-hidden="true"><span></span><span></span><span></span></div></div>
    <noscript><p class="empty-state">请启用 JavaScript，以加载试卷列表。</p></noscript>
  </div></div>
</section>

<section class="reader-section container" id="reader" hidden aria-labelledby="reader-title">
  <div class="reader-topline">
    <button type="button" class="text-link" id="close-reader"><span aria-hidden="true">←</span> 返回题库</button>
    <div class="mode-switch" role="group" aria-label="学习模式"><button type="button" data-reader-mode="intensive">精读</button><button type="button" data-reader-mode="practice">做题</button></div>
  </div>
  <div class="reader-panel"><header class="reader-heading"><p class="reader-meta" id="reader-meta"></p><h2 id="reader-title" tabindex="-1">准备开始</h2><p id="reader-status" role="status" aria-live="polite"></p></header><div id="reader-content"></div></div>
</section>

<script define:vars={{ apiBase, examLevels }}>
  const status = document.querySelector('#status');
  const papers = document.querySelector('#papers');
  const reader = document.querySelector('#reader');
  const readerTitle = document.querySelector('#reader-title');
  const readerMeta = document.querySelector('#reader-meta');
  const readerStatus = document.querySelector('#reader-status');
  const readerContent = document.querySelector('#reader-content');
  const retryPapers = document.querySelector('#retry-papers');
  const libraryResults = document.querySelector('#library-results');
  const search = document.querySelector('#paper-search');
  const modeButtons = [...document.querySelectorAll('[data-reader-mode]')];
  let allPapers = [];
  let activePaper = null;

  function levelName(level) { return level === 'CET6' ? '六级' : level === 'NEEP' ? '考研' : '四级'; }
  function createModeButton(text, mode, paper) {
    const button = document.createElement('button'); button.type = 'button'; button.className = 'button button-small paper-mode-button'; button.textContent = text;
    button.addEventListener('click', () => openPaper(paper, mode)); return button;
  }
  function showPapers() {
    const query = search.value.trim().toLowerCase();
    const visible = allPapers.filter((paper) => examLevels.includes(paper.exam_level) && (!query || `${paper.title} ${paper.year} ${paper.exam_level}`.toLowerCase().includes(query)));
    papers.replaceChildren();
    if (!visible.length) { papers.innerHTML = '<div class="empty-state"><strong>暂无试卷</strong></div>'; return; }
    for (const paper of visible) {
      const item = document.createElement('article'); item.className = 'paper-card';
      const top = document.createElement('div'); top.className = 'paper-card-top';
      const level = document.createElement('span'); level.className = 'paper-level'; level.textContent = `${levelName(paper.exam_level)} `;
      const code = document.createElement('small'); code.textContent = paper.exam_level.replace('CET', 'CET-'); level.append(code); top.append(level); item.append(top);
      const heading = document.createElement('h3'); heading.textContent = paper.title; item.append(heading);
      const bottom = document.createElement('div'); bottom.className = 'paper-card-bottom'; bottom.innerHTML = `<span>${paper.year} · ${String(paper.month).padStart(2, '0')} · ${paper.variant || `第 ${paper.set_no} 套`}</span><span class="paper-type">${paper.content_state === 'external' ? '原站资料' : (paper.is_demo ? '本地演示' : '已导入')}</span>`; item.append(bottom);
      const actions = document.createElement('div'); actions.className = 'paper-card-actions';
      if (paper.content_state === 'external') {
        const source = document.createElement('a'); source.className = 'button button-small paper-source'; source.href = paper.source_url; source.target = '_blank'; source.rel = 'noreferrer'; source.textContent = '原站查看'; actions.append(source);
        const note = document.createElement('span'); note.className = 'paper-mode-note'; note.textContent = '内容未托管'; actions.append(note);
      } else actions.append(createModeButton('精读', 'intensive', paper), createModeButton('做题', 'practice', paper));
      item.append(actions); papers.append(item);
    }
  }
  async function fetchPaper(id) { const response = await fetch(`${apiBase}/api/papers/${encodeURIComponent(id)}`); if (!response.ok) throw new Error('paper request failed'); return response.json(); }
  function updateUrl(paperId, mode) { const url = new URL(window.location.href); url.search = `?paper=${encodeURIComponent(paperId)}&mode=${mode}`; history.pushState({}, '', url); }
  async function openPaper(summary, mode) {
    if (!summary) return;
    activePaper = await fetchPaper(summary.id); if (activePaper.content_state !== 'local') return;
    updateUrl(summary.id, mode); reader.hidden = false; modeButtons.forEach((button) => button.classList.toggle('active', button.dataset.readerMode === mode));
    readerMeta.textContent = `${levelName(activePaper.exam_level)} · ${activePaper.year} · ${activePaper.variant || `第 ${activePaper.set_no} 套`}`; readerTitle.textContent = activePaper.title; readerStatus.textContent = mode === 'intensive' ? '逐句阅读，按需生成精读' : '选择答案并提交，主观题只保存作答'; readerContent.replaceChildren(); reader.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (mode === 'intensive') renderIntensive(activePaper); else await renderPractice(activePaper); readerTitle.focus({ preventScroll: true });
  }
  function renderIntensive(paper) { if (!paper.sentences.length) { readerContent.innerHTML = '<div class="empty-state"><strong>本地尚未导入原文</strong><span>该试卷目前只能从原站查看。</span></div>'; return; } for (const [index, sentence] of paper.sentences.entries()) renderSentence(sentence, index); }
  function renderSentence(sentence, index) {
    const article = document.createElement('article'); article.className = 'sentence'; const number = document.createElement('span'); number.className = 'sentence-number'; number.textContent = String(index + 1).padStart(2, '0');
    const content = document.createElement('div'); content.className = 'sentence-content'; const source = document.createElement('p'); source.className = 'source'; source.lang = 'en'; source.textContent = sentence.source;
    const button = document.createElement('button'); button.className = 'button button-small'; button.textContent = '开始精读'; const result = document.createElement('div'); result.className = 'analysis-result'; button.addEventListener('click', () => analyze(sentence.id, button, result)); content.append(source, button, result); article.append(number, content); readerContent.append(article);
  }
  async function analyze(sentenceId, button, result) {
    button.disabled = true; button.textContent = '生成中…';
    try { const response = await fetch(`${apiBase}/api/sentences/${sentenceId}/analyze?mode=intensive`, { method: 'POST' }); if (!response.ok) throw new Error('analysis request failed'); const body = await response.json(); if (body.status === 'ready') { renderAnalysis(body.result, result); button.remove(); return; } await poll(body.jobId, button, result); }
    catch { button.disabled = false; button.textContent = '重试精读'; result.textContent = '精读暂时不可用，请稍后重试。'; }
  }
  async function poll(jobId, button, result) {
    const response = await fetch(`${apiBase}/api/jobs/${jobId}`); const job = await response.json();
    if (job.status === 'succeeded') { const analysisResponse = await fetch(`${apiBase}/api/sentences/${job.sentence_id}/analyze?mode=intensive`, { method: 'POST' }); const analysis = await analysisResponse.json(); renderAnalysis(analysis.result, result); button.remove(); }
    else if (job.status === 'failed') { button.disabled = false; button.textContent = '重试精读'; result.textContent = job.error_message ?? '生成失败，请重试。'; }
    else setTimeout(() => poll(jobId, button, result), 1500);
  }
  async function renderPractice(paper) {
    const response = await fetch(`${apiBase}/api/papers/${paper.id}/attempts`, { method: 'POST' }); if (!response.ok) { readerContent.innerHTML = '<div class="empty-state error-state"><strong>做题模式暂不可用</strong></div>'; return; }
    const attempt = await response.json(); const form = document.createElement('form'); form.className = 'practice-form';
    for (const section of paper.sections) {
      const block = document.createElement('section'); block.className = 'practice-section'; const heading = document.createElement('h3'); heading.textContent = section.title; block.append(heading);
      for (const paragraph of section.paragraphs ?? []) { const text = document.createElement('p'); text.className = 'practice-paragraph'; text.textContent = paragraph; block.append(text); }
      for (const question of section.questions) {
        const item = document.createElement('fieldset'); item.className = 'practice-question'; const legend = document.createElement('legend'); legend.textContent = question.prompt; item.append(legend);
        if (question.type === 'choice') for (const option of question.options) { const label = document.createElement('label'); const input = document.createElement('input'); input.type = 'radio'; input.name = question.id; input.value = option.key; label.append(input, document.createTextNode(` ${option.key}. ${option.text}`)); item.append(label); }
        else { const textarea = document.createElement('textarea'); textarea.name = question.id; textarea.rows = 5; textarea.placeholder = '在这里作答'; item.append(textarea); }
        block.append(item);
      }
      form.append(block);
    }
    const submit = document.createElement('button'); submit.type = 'submit'; submit.className = 'button button-small'; submit.textContent = '提交答案'; const result = document.createElement('div'); result.className = 'practice-result'; form.append(submit, result);
    form.addEventListener('submit', async (event) => { event.preventDefault(); submit.disabled = true; const answers = Object.fromEntries([...form.querySelectorAll('input:checked, textarea')].map((input) => [input.name, input.value]));
      try { const saved = await fetch(`${apiBase}/api/attempts/${attempt.id}/answers`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ answers }) }); if (!saved.ok) throw new Error('save failed'); const submittedResponse = await fetch(`${apiBase}/api/attempts/${attempt.id}/submit`, { method: 'POST' }); if (!submittedResponse.ok) throw new Error('submit failed'); renderPracticeResult((await submittedResponse.json()).result, result); }
      catch { result.textContent = '提交失败，请重试。'; submit.disabled = false; }
    });
    readerContent.append(form);
  }
  function renderPracticeResult(summary, target) { target.replaceChildren(); const heading = document.createElement('strong'); heading.textContent = `客观题 ${summary.objectiveScore} / ${summary.objectiveTotal} · ${summary.manualCount} 道主观题待自行核对`; target.append(heading); for (const question of summary.questions) { const line = document.createElement('p'); line.textContent = question.status === 'manual' ? `${question.id}：已保存作答` : `${question.id}：${question.status === 'correct' ? '正确' : question.status === 'unanswered' ? '未作答' : `错误，答案 ${question.correctAnswer}`} · ${question.explanation}`; target.append(line); } }
  function renderAnalysis(analysis, target) {
    target.replaceChildren(); const translation = document.createElement('p'); translation.className = 'translation'; translation.textContent = analysis.translation; const pattern = document.createElement('p'); pattern.className = 'pattern'; pattern.textContent = analysis.pattern; target.append(translation, pattern);
    const grammar = document.createElement('ul'); grammar.className = 'grammar'; grammar.append(Object.assign(document.createElement('li'), { textContent: `${analysis.grammar.sentenceType} · ${analysis.grammar.tense} · ${analysis.grammar.voice}` })); for (const clause of analysis.grammar.clauses) grammar.append(Object.assign(document.createElement('li'), { textContent: `${clause.type}：${clause.explanation}` })); target.append(grammar);
    const tokens = document.createElement('div'); tokens.className = 'tokens'; const detail = document.createElement('p'); detail.className = 'word-detail'; detail.hidden = true;
    for (const token of analysis.tokens) { const clickable = token.kind === 'word'; const span = document.createElement(clickable ? 'button' : 'span'); span.className = `token${clickable ? ' word' : ''}`; span.textContent = token.text; if (clickable) span.addEventListener('click', () => { detail.hidden = false; detail.textContent = `${token.text} · ${token.lemma} · ${token.pos}：${token.contextMeaning}`; }); tokens.append(span); }
    target.append(tokens, detail);
  }
  async function loadPapers() {
    retryPapers.hidden = true; status.textContent = '正在加载'; libraryResults.setAttribute('aria-busy', 'true');
    try { const response = await fetch(`${apiBase}/api/papers`); if (!response.ok) throw new Error('paper request failed'); allPapers = (await response.json()).papers ?? []; status.textContent = '题库已加载'; showPapers(); const params = new URLSearchParams(location.search); const paper = allPapers.find((item) => item.id === params.get('paper')); if (paper && paper.content_state === 'local') await openPaper(paper, params.get('mode') === 'practice' ? 'practice' : 'intensive'); }
    catch { status.textContent = '暂时无法连接阅读题库。'; retryPapers.hidden = false; papers.innerHTML = '<div class="empty-state error-state"><strong>阅读内容加载失败</strong><span>请稍后再试，或确认后端服务正在运行。</span></div>'; }
    finally { libraryResults.setAttribute('aria-busy', 'false'); }
  }
  modeButtons.forEach((button) => button.addEventListener('click', () => { if (activePaper) openPaper(allPapers.find((paper) => paper.id === activePaper.id), button.dataset.readerMode); }));
  retryPapers.addEventListener('click', loadPapers);
  document.querySelector('#close-reader').addEventListener('click', () => { reader.hidden = true; history.pushState({}, '', location.pathname); document.querySelector('#library').scrollIntoView({ behavior: 'smooth' }); });
  search.addEventListener('input', showPapers); loadPapers();
</script>

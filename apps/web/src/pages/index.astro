---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> A LITTLE DEEPER, EVERY DAY</p>
      <h1 id="hero-title">从读懂一句，<br />到<span class="hero-emphasis">读透一篇。</span></h1>
      <p class="hero-description">让英语阅读，不再停留在“看懂大意”。<br class="desktop-break" />逐句理解、拆解结构，把每一次阅读变成真正的积累。</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#library">开启一次精读 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#method">了解精读方法 <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-note">
        <span class="note-mark" aria-hidden="true">✓</span>
        <span>逐句翻译</span><span class="note-dot" aria-hidden="true">·</span>
        <span>语法拆解</span><span class="note-dot" aria-hidden="true">·</span>
        <span>语境词义</span>
      </div>
    </div>
    <div class="hero-preview">
      <span class="preview-orbit" aria-hidden="true"></span>
      <span class="preview-margin-note" aria-hidden="true">READ BETWEEN THE LINES.</span>
      <article class="preview-card" aria-label="精读示例预览">
        <div class="preview-heading">
          <span class="preview-label"><span class="live-dot" aria-hidden="true"></span> 精读预览</span>
          <span class="preview-page">SENTENCE 01</span>
        </div>
        <p class="preview-source" lang="en"><button type="button" class="preview-word connector" data-preview-word="although" aria-pressed="false">Although</button> the plan was <button type="button" class="preview-word" data-preview-word="expensive" aria-pressed="true">expensive</button>,<br />it was <button type="button" class="preview-word" data-preview-word="successful" aria-pressed="false">successful</button>.</p>
        <div class="preview-structure" aria-label="句子结构">
          <span><i class="structure-dot warm" aria-hidden="true"></i>让步状语从句</span>
          <span class="structure-join" aria-hidden="true">+</span>
          <span><i class="structure-dot green" aria-hidden="true"></i>主句</span>
        </div>
        <div class="preview-translation">
          <span class="mini-label">句意</span>
          <p>虽然这个计划成本很高，但它还是成功了。</p>
        </div>
        <div class="preview-definition" id="preview-definition" aria-live="polite">
          <div><strong lang="en">expensive</strong><span class="word-pos">adj.</span></div>
          <p>昂贵的；在这里指计划的成本很高。</p>
        </div>
        <div class="preview-footer"><span class="preview-pointer" aria-hidden="true">↖</span> 点击划线单词，看看它在句中的含义<span class="sample-label">示例句</span></div>
      </article>
      <div class="preview-caption"><span class="caption-line" aria-hidden="true"></span> 不只是翻译，更是理解。</div>
    </div>
  </section>

  <div class="feature-strip">
    <div class="container feature-inner">
      <div class="feature-item"><span class="feature-number">01</span><div><strong>先读，再理解</strong><span>保留原文，主动思考</span></div></div>
      <div class="feature-item"><span class="feature-number">02</span><div><strong>每一句，都读透</strong><span>译文、句型、结构一起掌握</span></div></div>
      <div class="feature-item"><span class="feature-number">03</span><div><strong>让单词回到语境</strong><span>理解它在这句话中的含义</span></div></div>
    </div>
  </div>

  <section class="library-section container" id="library" aria-labelledby="library-title">
    <div class="section-heading">
      <div><p class="eyebrow">YOUR NEXT GOOD READ</p><h2 id="library-title">从这里，开始阅读<span class="heading-period">。</span></h2></div>
      <p class="section-intro">选一篇文章，留一点时间。<br />认真读懂，比匆匆读过更有价值。</p>
    </div>
    <div class="library-toolbar">
      <div class="filter-tabs" role="group" aria-label="按考试类型筛选">
        <button type="button" class="filter-tab" data-level="all" aria-pressed="true">全部阅读</button>
        <button type="button" class="filter-tab" data-level="CET4" aria-pressed="false">四级 <span>CET-4</span></button>
        <button type="button" class="filter-tab" data-level="CET6" aria-pressed="false">六级 <span>CET-6</span></button>
      </div>
      <label class="paper-search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <span class="sr-only">搜索文章标题或年份</span>
        <input id="paper-search" type="search" placeholder="搜索标题或年份" autocomplete="off" />
      </label>
    </div>
    <div class="library-content">
      <div class="library-results" aria-busy="true" id="library-results">
        <div class="library-status"><p id="status" role="status" aria-live="polite">正在为你整理阅读内容…</p><button type="button" class="text-link" id="retry-papers" hidden>重新加载 <span aria-hidden="true">↻</span></button><span class="result-count" id="paper-count"></span></div>
        <div class="paper-grid" id="papers"><div class="paper-skeleton" aria-hidden="true"><span></span><span></span><span></span></div></div>
        <noscript><p class="empty-state">请启用 JavaScript，以加载文章并使用逐句精读功能。</p></noscript>
      </div>
      <aside class="reading-aside">
        <span class="aside-mark" aria-hidden="true">“</span>
        <p class="eyebrow">A MOMENT TO FOCUS</p>
        <h3>给理解一点时间。</h3>
        <p>先试着读完原文，再打开需要帮助的句子。每一次主动思考，都是更扎实的一步。</p>
        <div class="aside-bottom"><span class="aside-line" aria-hidden="true"></span><span>慢一点，读深一点。</span></div>
      </aside>
    </div>
  </section>

  <section class="reader-section container" id="reader" hidden aria-labelledby="reader-title">
    <div class="reader-topline"><button type="button" class="text-link" id="close-reader"><span aria-hidden="true">←</span> 返回题库</button><span class="eyebrow">FOCUS &amp; UNDERSTAND</span></div>
    <div class="reader-panel">
      <header class="reader-heading"><p class="reader-meta" id="reader-meta"></p><h2 id="reader-title" tabindex="-1">准备开始阅读</h2><p id="reader-status" role="status" aria-live="polite"></p></header>
      <div id="sentences"></div>
    </div>
  </section>

  <section class="method-section" id="method" aria-labelledby="method-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">READ WITH INTENTION</p><h2 id="method-title">一次精读，三步积累。</h2></div><p class="section-intro">让每次阅读，都多一层理解。</p></div>
      <div class="method-grid">
        <article class="method-card"><div class="method-top"><span class="method-number">01 /</span><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 7h8a4 4 0 0 1 4 4v16a6 6 0 0 0-5-3H5V7Zm22 0h-6a4 4 0 0 0-4 4v16a6 6 0 0 1 5-3h5V7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg></div><h3>先读原文</h3><p>带着问题阅读，尝试抓住主旨和句子主干。给自己一个独立理解的机会。</p><span class="method-keyword">Read first.</span></article>
        <article class="method-card"><div class="method-top"><span class="method-number">02 /</span><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M7 8h18M7 16h18M7 24h18M12 5v6m8 2v6m-9 2v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="12" cy="8" r="2.5" fill="var(--surface)" stroke="currentColor" stroke-width="1.4" /><circle cx="20" cy="16" r="2.5" fill="var(--surface)" stroke="currentColor" stroke-width="1.4" /><circle cx="11" cy="24" r="2.5" fill="var(--surface)" stroke="currentColor" stroke-width="1.4" /></svg></div><h3>拆解句子</h3><p>按需打开精读，对照译文、句型和语法结构，把复杂的长句读清楚。</p><span class="method-keyword">Look closer.</span></article>
        <article class="method-card"><div class="method-top"><span class="method-number">03 /</span><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M7 5h18v23l-9-5-9 5V5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="M12 11h8m-8 5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></div><h3>理解表达</h3><p>点击单词查看词性与语境释义，留意句中的搭配，让词汇和表达一起积累。</p><span class="method-keyword">Make it yours.</span></article>
      </div>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const status = document.querySelector('#status');
    const papers = document.querySelector('#papers');
    const reader = document.querySelector('#reader');
    const readerTitle = document.querySelector('#reader-title');
    const readerMeta = document.querySelector('#reader-meta');
    const readerStatus = document.querySelector('#reader-status');
    const sentences = document.querySelector('#sentences');
    const paperCount = document.querySelector('#paper-count');
    const retryPapers = document.querySelector('#retry-papers');
    const libraryResults = document.querySelector('#library-results');
    const search = document.querySelector('#paper-search');
    const filterTabs = [...document.querySelectorAll('[data-level]')];
    let allPapers = [];
    let activeLevel = 'all';

    function showPapers() {
      const query = search.value.trim().toLowerCase();
      const visible = allPapers.filter((paper) => {
        const matchesLevel = activeLevel === 'all' || paper.exam_level === activeLevel;
        const matchesQuery = !query || `${paper.title} ${paper.year} ${paper.exam_level}`.toLowerCase().includes(query);
        return matchesLevel && matchesQuery;
      });
      papers.replaceChildren();
      paperCount.textContent = allPapers.length ? `共 ${visible.length} 篇` : '';
      if (!visible.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-state';
        empty.innerHTML = '<strong>暂时没有匹配的文章</strong><span>换一个关键词，或看看全部阅读。</span>';
        papers.append(empty);
        return;
      }
      for (const paper of visible) {
        const item = document.createElement('article');
        item.className = 'paper-card';
        const level = paper.exam_level === 'CET6' ? '六级' : '四级';
        item.innerHTML = `<div class="paper-card-top"><span class="paper-level">${level} <small>${paper.exam_level.replace('CET', 'CET-')}</small></span><span class="paper-arrow" aria-hidden="true">↗</span></div><h3></h3><div class="paper-card-bottom"><span>${paper.year} · ${String(paper.month).padStart(2, '0')} · 第 ${paper.set_no} 套</span><span class="paper-type">${paper.is_demo ? '练习文章' : '真题阅读'}</span></div>`;
        item.querySelector('h3').textContent = paper.title;
        item.setAttribute('tabindex', '0');
        item.setAttribute('role', 'button');
        item.addEventListener('click', () => loadPaper(paper.id));
        item.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); loadPaper(paper.id); } });
        papers.append(item);
      }
    }

    async function loadPapers() {
      retryPapers.hidden = true;
      status.textContent = '正在为你整理阅读内容…';
      libraryResults.setAttribute('aria-busy', 'true');
      papers.replaceChildren();
      try {
        const response = await fetch(`${apiBase}/api/papers`);
        if (!response.ok) throw new Error('paper request failed');
        const data = await response.json();
        allPapers = data.papers ?? [];
        status.textContent = allPapers.length ? '选择一篇文章，开始你的精读。' : '目前还没有发布的试卷。';
        showPapers();
      } catch {
        status.textContent = '暂时无法连接阅读题库。';
        retryPapers.hidden = false;
        const error = document.createElement('div');
        error.className = 'empty-state error-state';
        error.innerHTML = '<strong>阅读内容加载失败</strong><span>请稍后再试，或确认后端服务正在运行。</span>';
        papers.append(error);
      } finally {
        libraryResults.setAttribute('aria-busy', 'false');
      }
    }

    async function loadPaper(id) {
      reader.hidden = false;
      readerStatus.textContent = '正在读取原文…';
      readerMeta.textContent = '';
      readerTitle.textContent = '准备开始阅读';
      sentences.replaceChildren();
      reader.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try {
        const response = await fetch(`${apiBase}/api/papers/${id}`);
        if (!response.ok) throw new Error('paper request failed');
        const paper = await response.json();
        readerTitle.textContent = paper.title;
        readerMeta.textContent = `${paper.exam_level === 'CET6' ? '六级' : '四级'} · ${paper.year} · 第 ${paper.set_no} 套`;
        readerStatus.textContent = `${paper.sentences.length} 句话 · 先读原文，再按需打开精读`;
        for (const [index, sentence] of paper.sentences.entries()) renderSentence(sentence, index);
        readerTitle.focus({ preventScroll: true });
      } catch {
        readerStatus.textContent = '文章读取失败，请稍后重试。';
      }
    }

    function renderSentence(sentence, index) {
      const article = document.createElement('article');
      article.className = 'sentence';
      const number = document.createElement('span');
      number.className = 'sentence-number';
      number.textContent = String(index + 1).padStart(2, '0');
      const content = document.createElement('div');
      content.className = 'sentence-content';
      const source = document.createElement('p');
      source.className = 'source';
      source.lang = 'en';
      source.textContent = sentence.source;
      const button = document.createElement('button');
      button.className = 'button button-small';
      button.textContent = '开始精读';
      const result = document.createElement('div');
      result.className = 'analysis-result';
      button.addEventListener('click', () => analyze(sentence.id, button, result));
      content.append(source, button, result);
      article.append(number, content);
      sentences.append(article);
    }

    async function analyze(sentenceId, button, result) {
      button.disabled = true;
      button.textContent = '生成中…';
      try {
        const response = await fetch(`${apiBase}/api/sentences/${sentenceId}/analyze`, { method: 'POST' });
        if (!response.ok) throw new Error('analysis request failed');
        const body = await response.json();
        if (body.status === 'ready') { renderAnalysis(body.result, result); button.remove(); return; }
        await poll(body.jobId, button, result);
      } catch {
        button.disabled = false;
        button.textContent = '重试精读';
        result.textContent = '精读暂时不可用，请稍后重试。';
      }
    }

    async function poll(jobId, button, result) {
      const response = await fetch(`${apiBase}/api/jobs/${jobId}`);
      const job = await response.json();
      if (job.status === 'succeeded') {
        const analysisResponse = await fetch(`${apiBase}/api/sentences/${job.sentence_id}/analyze`, { method: 'POST' });
        const analysis = await analysisResponse.json();
        renderAnalysis(analysis.result, result);
        button.remove();
      } else if (job.status === 'failed') {
        button.disabled = false;
        button.textContent = '重试精读';
        result.textContent = job.error_message ?? '生成失败，请重试。';
      } else setTimeout(() => poll(jobId, button, result), 1500);
    }

    function renderAnalysis(analysis, target) {
      target.replaceChildren();
      const translation = document.createElement('p');
      translation.className = 'translation';
      translation.textContent = analysis.translation;
      const pattern = document.createElement('p');
      pattern.className = 'pattern';
      pattern.textContent = analysis.pattern;
      target.append(translation, pattern);
      const grammar = document.createElement('ul');
      grammar.className = 'grammar';
      grammar.append(Object.assign(document.createElement('li'), { textContent: `${analysis.grammar.sentenceType} · ${analysis.grammar.tense} · ${analysis.grammar.voice}` }));
      for (const clause of analysis.grammar.clauses) grammar.append(Object.assign(document.createElement('li'), { textContent: `${clause.type}：${clause.explanation}` }));
      target.append(grammar);
      const tokens = document.createElement('div');
      tokens.className = 'tokens';
      const detail = document.createElement('p');
      detail.className = 'word-detail';
      detail.hidden = true;
      for (const token of analysis.tokens) {
        const clickable = token.kind === 'word';
        const span = document.createElement(clickable ? 'button' : 'span');
        span.className = `token${clickable ? ' word' : ''}`;
        span.textContent = token.contextMeaning ? `${token.text} · ${token.contextMeaning}` : token.text;
        if (clickable) span.addEventListener('click', () => { detail.hidden = false; detail.textContent = `${token.text} · ${token.lemma} · ${token.pos}：${token.contextMeaning}`; });
        tokens.append(span);
      }
      target.append(tokens, detail);
    }

    document.querySelector('#retry-papers').addEventListener('click', loadPapers);
    document.querySelector('#close-reader').addEventListener('click', () => { reader.hidden = true; document.querySelector('#library').scrollIntoView({ behavior: 'smooth' }); });
    search.addEventListener('input', showPapers);
    filterTabs.forEach((tab) => tab.addEventListener('click', () => { activeLevel = tab.dataset.level; filterTabs.forEach((item) => item.setAttribute('aria-pressed', String(item === tab))); showPapers(); }));
    document.querySelectorAll('[data-preview-word]').forEach((word) => word.addEventListener('click', () => {
      const definitions = { although: ['although', 'conj.', '虽然；引导让步状语从句'], expensive: ['expensive', 'adj.', '昂贵的；在这里指计划的成本很高。'], successful: ['successful', 'adj.', '成功的；表示计划最终达成了预期结果。'] };
      const [text, pos, meaning] = definitions[word.dataset.previewWord];
      document.querySelectorAll('[data-preview-word]').forEach((item) => item.setAttribute('aria-pressed', String(item === word)));
      document.querySelector('#preview-definition').innerHTML = `<div><strong lang="en">${text}</strong><span class="word-pos">${pos}</span></div><p>${meaning}</p>`;
    }));
    loadPapers();
  </script>
</Layout>

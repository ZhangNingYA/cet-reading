---
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---
<Layout title="精读管理 · CET Reading" description="查看 AI 请求、精读进度与处理失败任务">
  <section class="admin-section container" id="admin-analysis" data-api-base={apiBase} aria-labelledby="admin-title">
    <header class="admin-heading">
      <div><h1 id="admin-title">精读管理</h1><p id="admin-backfill-state" class="admin-subtitle">正在读取运行状态…</p></div>
      <div class="admin-controls">
        <label class="admin-speed"><span>同时生成</span><select id="admin-concurrency" disabled aria-label="同时生成的任务数量"><option value="1">1 条</option><option value="2">2 条</option><option value="3">3 条</option><option value="4">4 条</option></select></label>
        <button class="button button-small" id="admin-toggle-backfill" type="button" disabled>暂停自动生成</button>
      </div>
    </header>

    <div class="admin-summary" aria-label="当前任务数量">
      <div><span class="admin-summary-dot is-running" aria-hidden="true"></span><span>生成中</span><strong id="admin-running">—</strong></div>
      <div><span class="admin-summary-dot" aria-hidden="true"></span><span>排队中</span><strong id="admin-pending">—</strong></div>
      <button id="admin-show-failed" type="button" aria-label="查看失败任务"><span class="admin-summary-dot is-failed" aria-hidden="true"></span><span>失败</span><strong id="admin-failed">—</strong><span class="admin-summary-arrow" aria-hidden="true">↗</span></button>
      <span id="admin-observed-at" class="admin-updated"></span>
      <button class="text-link" id="admin-refresh" type="button">刷新</button>
    </div>
    <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>
    <div id="admin-priority" class="admin-priority" hidden>
      <div id="admin-priority-list"></div>
      <button class="text-link" id="admin-clear-priority" type="button">取消全部</button>
    </div>

    <div class="admin-tabs" role="tablist" aria-label="管理内容">
      <button id="admin-requests-tab" type="button" role="tab" aria-selected="true" aria-controls="admin-requests-panel" tabindex="0">AI 请求</button>
      <button id="admin-progress-tab" type="button" role="tab" aria-selected="false" aria-controls="admin-progress-panel" tabindex="-1">精读进度</button>
    </div>

    <section id="admin-requests-panel" class="admin-panel" role="tabpanel" aria-labelledby="admin-requests-tab" aria-busy="true">
      <div class="admin-toolbar">
        <div class="admin-job-filters" role="group" aria-label="请求状态">
          <button type="button" data-job-status="active" aria-pressed="true">进行中</button>
          <button type="button" data-job-status="failed" aria-pressed="false">失败</button>
          <button type="button" data-job-status="succeeded" aria-pressed="false">已完成</button>
        </div>
        <label class="sr-only" for="admin-job-type">精读类型</label>
        <select id="admin-job-type"><option value="">全部精读</option><option value="sentence">文章精读</option><option value="text">题面精读</option><option value="question">做题精读</option></select>
        <div class="admin-toolbar-actions">
          <button class="button button-small admin-retry-all" id="admin-retry-all" type="button" hidden>重试失败任务</button>
          <button class="button button-small admin-clear-failures" id="admin-clear-failures" type="button" hidden>清空全部失败</button>
        </div>
      </div>
      <div id="admin-job-list" class="admin-job-list"><p class="admin-empty">正在读取请求…</p></div>
      <button class="button admin-load-more" id="admin-job-more" type="button" hidden>加载更多请求</button>
      <p id="admin-job-count" class="admin-footnote"></p>
    </section>

    <section id="admin-progress-panel" class="admin-panel" role="tabpanel" aria-labelledby="admin-progress-tab" aria-busy="true" hidden>
      <div class="admin-catalog-tabs" role="group" aria-label="精读内容目录">
        <button type="button" data-progress-board="CET4" aria-pressed="true">英语四级</button>
        <button type="button" data-progress-board="CET6" aria-pressed="false">英语六级</button>
        <button type="button" data-progress-board="POSTGRAD" aria-pressed="false">考研英语</button>
        <button type="button" data-progress-board="NEWS" aria-pressed="false">News</button>
      </div>
      <div class="admin-toolbar admin-progress-toolbar">
        <label class="sr-only" for="admin-paper-search">查找试卷或资讯</label>
        <input id="admin-paper-search" type="search" placeholder="搜索四级试卷、年份" autocomplete="off" />
        <span id="admin-paper-count" class="admin-count"></span>
      </div>
      <div class="admin-catalog-filterbar">
        <div class="admin-catalog-filters" role="group" aria-label="目录完成状态">
          <button type="button" data-catalog-filter="all" aria-pressed="true">全部 <span data-catalog-count="all">—</span></button>
          <button type="button" data-catalog-filter="unfinished" aria-pressed="false">未完成 <span data-catalog-count="unfinished">—</span></button>
          <button type="button" data-catalog-filter="completed" aria-pressed="false">已完成 <span data-catalog-count="completed">—</span></button>
          <button type="button" data-catalog-filter="queued" aria-pressed="false" title="已加入优先队列的整套、整篇或具体篇目">已排队 <span data-catalog-count="queued">—</span></button>
        </div>
        <button id="admin-catalog-reset" class="text-link" type="button" hidden>重置筛选</button>
      </div>
      <p class="admin-footnote">选择文章精读、题面精读或做题精读即可加入队列；已加入的项目会标出排队状态。</p>
      <div class="admin-progress-head" aria-hidden="true"><span id="admin-catalog-kind">试卷目录</span><span>文章精读</span><span>题面精读</span><span>做题精读</span></div>
      <div id="admin-paper-list" class="admin-paper-list"><p class="admin-empty">正在读取精读进度…</p></div>
      <div id="admin-paper-pagination" class="admin-pagination" hidden><button class="button button-small" id="admin-paper-prev" type="button">上一页</button><span id="admin-paper-page"></span><button class="button button-small" id="admin-paper-next" type="button">下一页</button></div>
      <p class="admin-footnote">已完成的内容保留在目录中。排队项目可在上方队列中取消。</p>
    </section>
    <noscript><p class="empty-state">请启用 JavaScript 以使用精读管理。</p></noscript>
    <dialog id="admin-job-dialog" class="admin-detail-dialog" aria-labelledby="admin-detail-title">
      <div class="admin-detail-shell">
        <header class="admin-detail-heading">
          <div><div class="admin-detail-eyebrow"><span>请求详情</span><span id="admin-detail-state" class="admin-state"></span></div><h2 id="admin-detail-title">请求详情</h2></div>
          <button id="admin-detail-close" type="button" aria-label="关闭请求详情">×</button>
        </header>
        <div class="admin-detail-tools"><a id="admin-detail-source" class="text-link" hidden>查看原文 ↗</a><button id="admin-detail-refresh" class="text-link" type="button">刷新详情</button><p id="admin-detail-feedback" role="status" aria-live="polite"></p></div>
        <div id="admin-detail-body" class="admin-detail-body" aria-busy="false"></div>
      </div>
    </dialog>
  </section>
</Layout>
<script>import '../../scripts/admin-analysis';</script>

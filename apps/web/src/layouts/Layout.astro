---
import '../styles/global.css';

const {
  title = 'CET Reading · 英语阅读',
  description = '从读懂一句，到读透一篇。逐句翻译、语法拆解与语境词义，让每一次英语阅读都有收获。',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">跳到内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="CET Reading 首页">
          <span class="brand-name">CET READING</span>
        </a>
        {!isHome && (
          <nav class="site-nav" aria-label="网站导航">
            <a href="/">首页</a>
          </nav>
        )}
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <small>CET READING</small>
      </div>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
import '../styles/reader.css';
import '../styles/reading-room.css';
import '../styles/article-chat.css';
import { homeSections } from '../data/sections';

const {
  title = 'CET Reading · 英语阅读',
  description = '从读懂一句，到读透一篇。逐句翻译、语法拆解与语境词义，让每一次英语阅读都有收获。',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body id="top" class={isHome ? 'home-page' : undefined}>
    <a class="skip-link" href="#content">跳到内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="CET Reading 首页">
          <span class="brand-name"><span class="brand-initials">CET</span><span class="brand-divider" aria-hidden="true">/</span><span class="brand-word">reading</span></span>
        </a>
        {isHome && <nav class="home-header-nav" aria-label="阅读板块快捷入口">{homeSections.map(section => <a href={`/${section.slug}/`}>{section.label}</a>)}</nav>}
        {!isHome && (
          <nav class="site-nav" aria-label="网站导航">
            <a href="/">首页</a>
            {homeSections.map((section) => (
              <a href={`/${section.slug}/`} aria-current={Astro.url.pathname === `/${section.slug}/` ? 'page' : undefined}>{section.label}</a>
            ))}
            <a class="site-nav-admin" href="/admin/analysis/" aria-current={Astro.url.pathname.startsWith('/admin/') ? 'page' : undefined} title="打开精读管理">管理</a>
          </nav>
        )}
      </div>
    </header>
    <main id="content"><slot /></main>
  </body>
</html>
